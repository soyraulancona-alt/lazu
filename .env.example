# ─── Base de datos ──────────────────────────────────────────────
# Cadena de conexión de PostgreSQL.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/lazu?schema=public"

# ─── Autenticación del dashboard ────────────────────────────────
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Genera uno con:  openssl rand -base64 48
AUTH_SECRET=""

# ─── Tracking ───────────────────────────────────────────────────
# Orígenes (dominios) desde donde los perfiles HTML pueden enviar eventos.
# Separados por coma, sin barra final. Admite comodín de subdominio "https://*.dominio".
# En desarrollo cualquier http://localhost:<puerto> y http://127.0.0.1:<puerto> se acepta siempre.
# Ejemplo producción: https://lazu.bio,https://*.lazu.bio,https://barberialux.com
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5500"

# Máximo de eventos por minuto por IP (opcional, por defecto 60).
TRACK_RATE_LIMIT_PER_MINUTE=60

# ─── Dashboard ──────────────────────────────────────────────────
# Zona horaria para agrupar las gráficas por día (opcional, por defecto UTC).
DASHBOARD_TIMEZONE="America/Mexico_City"

# ─── Seed (solo para crear el primer administrador) ─────────────
SEED_ADMIN_EMAIL="admin@lazu.local"
SEED_ADMIN_PASSWORD="cambia-esta-contraseña"
